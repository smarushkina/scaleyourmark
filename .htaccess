# Браузърът не бива да показва стара версия на страницата.
#
# Хостингът не праща Cache-Control за index.html, а само ETag и
# Last-Modified. В такъв случай браузърът сам решава колко да пази копието
# и често го пази с часове — затова качена промяна не се вижда, докато
# човекът не направи принудително презареждане.
#
# С реда отдолу браузърът пита сървъра при всяко отваряне. ETag остава, тоест
# при непроменен файл отговорът е 304 Not Modified и нищо не се тегли наново.

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
