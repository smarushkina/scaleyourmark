# Браузърът не бива да показва стара версия на страницата.
#
# Хостингът не праща Cache-Control за index.html, а само ETag и
# Last-Modified. В такъв случай браузърът сам решава колко да пази копието
# и често го пази с часове — затова качена промяна не се вижда, докато
# човекът не направи принудително презареждане.
#
# С реда отдолу браузърът пита сървъра при всяко отваряне. ETag остава, тоест
# при непроменен файл отговорът е 304 Not Modified и нищо не се тегли наново.

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  # Изображенията (og-image, лого, иконка) се сменят рядко.
  <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# ——— SEO: един адрес за всяка страница ———————————————————————————————
# Всяка страница съществува само на https://scaleyourmark.com/… .
# http:// и www. пренасочват постоянно (301) към него, за да не делят
# търсачките класирането между четири копия на сайта.
# /.well-known/ е изключен: оттам AutoSSL проверява домейна при подновяване
# на сертификата.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://scaleyourmark.com%{REQUEST_URI} [L,R=301]

  # /index.html и /раздел/index.html → /, /раздел/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?]
  RewriteRule ^(.*/)?index\.html$ /$1 [L,R=301]
</IfModule>

# Несъществуващ адрес: страница с 404 и навигация към сайта.
ErrorDocument 404 /404.html

# Компресия — страниците са ~860 KB, след gzip около четири пъти по-малко.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
